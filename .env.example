# Copy this to .env and fill in your OpenRouter key.
OPENROUTER_API_KEY=sk-or-v1-...

# Model. Default in code (backend/config.py) is anthropic/claude-3-5-sonnet-20241022.
# Override here if you want a different OpenRouter model id.
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet-20241022

# Optional: AI per-user rate limit (calls/hour). Default 20.
# AI_RATE_LIMIT_PER_HOUR=20

# Optional: comma-separated CORS origins. Defaults to http://localhost:3000.
# CORS_ORIGINS=http://localhost:3000

# Optional: NEXTAUTH_URL — used as HTTP-Referer when calling OpenRouter.
# NEXTAUTH_URL=http://localhost:3000
